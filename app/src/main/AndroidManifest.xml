<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.bakhawone.thesis_bakhawone">

    <!-- Permissions -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Optional storage permission if you save images outside app -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />

    <!-- Features -->
    <uses-feature android:name="android.hardware.camera.any" android:required="true" />
    <uses-feature android:name="android.hardware.camera.ar" android:required="false" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/bakhawone"
        android:label="@string/app_name"
        android:roundIcon="@drawable/bakhawone"
        android:supportsRtl="true"
        android:theme="@style/Theme.Thesisbakhawone.NoActionBar">

        <!-- Main Dashboard Activity -->
        <activity
            android:name=".DashboardActivity"
            android:exported="true"
            android:theme="@style/Theme.Thesisbakhawone.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- AR Activity -->
        <activity
            android:name=".ARActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Thesisbakhawone.NoActionBar" />

        <!-- Camera Activity (if needed) -->
        <activity
            android:name=".CameraActivity"
            android:exported="false"
            android:theme="@style/Theme.Thesisbakhawone.NoActionBar" />

    </application>
</manifest>
