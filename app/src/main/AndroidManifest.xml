<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.bakhawone.thesis_bakhawone">

    <!-- Permissions -->
    <!-- Location permissions for features that require GPS or location data -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Internet and network state permissions for Firebase, API calls, etc. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Camera access for image capture features -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" />

    <!-- Storage permissions (for Android 13 and below compatibility) -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/bakhawone"
        android:label="@string/app_name"
        android:roundIcon="@drawable/bakhawone"
        android:supportsRtl="true"
        android:theme="@style/Theme.Thesisbakhawone.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Thesisbakhawone.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SignupActivity"
            android:exported="false"
            android:theme="@style/Theme.Thesisbakhawone.NoActionBar" />

        <activity
            android:name=".DashboardActivity"
            android:exported="false"
            android:theme="@style/Theme.Thesisbakhawone.NoActionBar" />

        <activity
            android:name=".CameraActivity"
            android:exported="false"
            android:theme="@style/Theme.Thesisbakhawone.NoActionBar" />

    </application>
</manifest>